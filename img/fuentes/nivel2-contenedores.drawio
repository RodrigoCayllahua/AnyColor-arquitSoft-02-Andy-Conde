83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;SuperAdministrador&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1135" y="125" width="210" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#DCE6F6&#x27;&gt;[Contenedor: SPA Next.js / React]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Reserva para clientes, POS para cajeros y paneles de estilistas y administradores&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4A72B8;strokeColor=#36599A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="400" height="120" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.200;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="262"/><mxPoint x="640" y="262"/></Array></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.350;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="245"/><mxPoint x="700" y="245"/></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.650;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="245"/><mxPoint x="820" y="245"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.800;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="262"/><mxPoint x="880" y="262"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;API AnyColor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#DCE6F6&#x27;&gt;[Contenedor: Node.js + NestJS · monolito modular]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Reglas de negocio de citas, POS, inventario, personal y reportes. Sin estado: N instancias detrás de un balanceador&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#4A72B8;strokeColor=#36599A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="530" y="540" width="460" height="160" as="geometry"/></mxCell><mxCell id="c23" value="Llama a la API&lt;br&gt;[HTTPS/JSON + JWT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#DCE6F6&#x27;&gt;[Contenedor: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Fuente de verdad: citas, ventas, caja, inventario&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#4A72B8;strokeColor=#36599A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="420" y="815" width="250" height="150" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Caché y bloqueos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#DCE6F6&#x27;&gt;[Contenedor: Redis 7]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Bloqueos de 5 min, caché del catálogo y cola&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#4A72B8;strokeColor=#36599A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="730" y="815" width="240" height="150" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Réplica de lectura&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#666666&#x27;&gt;[Contenedor: PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Reportes pesados (Etapa 3)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#E9E9E9;strokeColor=#8A8A8A;fontColor=#444444;fontFamily=Arial;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="815" width="220" height="150" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Workers&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#DCE6F6&#x27;&gt;[Contenedor: Node.js + BullMQ]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Recordatorios, tickets PDF y exportaciones&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#4A72B8;strokeColor=#36599A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1110" y="820" width="250" height="140" as="geometry"/></mxCell><mxCell id="c28" value="Lee y escribe&lt;br&gt;[SQL/TCP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.152;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="760"/><mxPoint x="545" y="760"/></Array></mxGeometry></mxCell><mxCell id="c29" value="Bloquea, cachea&lt;br&gt;y encola [TCP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.696;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Consume&lt;br&gt;trabajos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="Replica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;dashed=1;endArrow=block;endFill=1;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Lee reportes&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;dashed=1;endArrow=block;endFill=1;exitX=0.000;exitY=0.625;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="640"/></Array></mxGeometry></mxCell><mxCell id="c33" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Pasarela de pagos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Tarjeta y Yape/Plin&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1460" y="500" width="270" height="110" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Almacenamiento de objetos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;S3 / Cloudinary (Etapa 2)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1460" y="640" width="270" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Servicio de mensajería&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;WhatsApp API / correo&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1460" y="835" width="270" height="110" as="geometry"/></mxCell><mxCell id="c36" value="Solicita cobros [HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=1.000;exitY=0.219;exitDx=0;exitDy=0;entryX=0.000;entryY=0.682;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Sube imágenes y tickets [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=1.000;exitY=0.844;exitDx=0;exitDy=0;entryX=0.000;entryY=0.318;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="Envía&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Persona · Sistema / contenedor · Componente · Sistema externo · Previsto (etapa futura)&lt;br&gt;Flecha: relación con verbo y [protocolo] · Línea discontinua: límite del sistema o elemento futuro" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fontFamily=Arial;strokeColor=#9A9A9A;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="720" height="92" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• El navegador solo habla con la aplicación web y la API; nunca con PostgreSQL ni Redis (RC05).&lt;br&gt;• Redis no es fuente de verdad: si se pierde un bloqueo, la restricción anti-solape de PostgreSQL impide citas duplicadas (ADR-003).&lt;br&gt;• Solo la API y los workers usan credenciales de proveedores; quedan en variables de entorno del servidor." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBE8;strokeColor=#C7B25A;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="800" y="1060" width="960" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>