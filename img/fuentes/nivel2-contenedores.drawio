<mxfile host="app.diagrams.net"><diagram name="nivel2-contenedores" id="nivel2-contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c15" value="&lt;b&gt;AnyColor Salón&lt;/b&gt; [Sistema de software]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#7A7A7A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="1300" height="720" as="geometry"/></mxCell><mxCell id="c2" value="[Diagrama de contenedores] AnyColor Salón" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1A1A1A;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="28" y="18" width="477" height="33" as="geometry"/></mxCell><mxCell id="c3" value="Modelo C4 · Nivel 2 (contenedores) · Estilo: monolito modular + SPA, API sin estado escalable horizontalmente" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#6A6A6A;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="28" y="52" width="691" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Vista de contenedores · v3" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#8A8A8A;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1617" y="28" width="155" height="18" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="256" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;font