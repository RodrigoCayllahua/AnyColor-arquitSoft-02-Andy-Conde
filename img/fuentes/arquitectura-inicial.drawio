xCell><mxCell id="c47" value="La lógica de negocio se separó en módulos desde el inicio; esta vista evoluciona al monolito modular (estilo) y a Clean Architecture dentro de cada módulo (enfoque)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="952" width="975" height="20" as="geometry"/></mxCell><mxCell id="c48" value="Cada flecha baja de una capa a la siguiente: la presentación nunca toca los datos directamente (RC05)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#444;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="977" width="610" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>