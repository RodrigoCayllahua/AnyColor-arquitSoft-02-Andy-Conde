ex="1" parent="1"><mxGeometry x="220" y="1240" width="220" height="140" as="geometry"/></mxCell><mxCell id="c51" value="Cada módulo lee y escribe&lt;br&gt;solo sus tablas [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" target="c49"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="1090" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c52" value="Lee métricas&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;dashed=1;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Persona · Sistema / contenedor · Componente · Sistema externo · Previsto (etapa futura)&lt;br&gt;Flecha: relación con verbo y [protocolo] · Línea discontinua: límite de contenedor o elemento futuro" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fontFamily=Arial;strokeColor=#9A9A9A;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="720" height="92" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Cada componente es un módulo del monolito: todos se despliegan juntos en el contenedor API AnyColor.&lt;br&gt;• Un módulo usa a otro solo por su API pública (caso de uso o evento), nunca sus tablas.&lt;br&gt;• El Catálogo guarda imágenes en el almacenamiento de objetos (Etapa 2); se omite aquí para no recargar la vista." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBE8;strokeColor=#C7B25A;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="800" y="1420" width="960" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>