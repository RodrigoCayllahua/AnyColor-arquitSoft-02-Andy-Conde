<mxfile host="app.diagrams.net"><diagram name="nivel1-contexto" id="nivel1-contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="[Diagrama de contexto] AnyColor Salón" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1A1A1A;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="28" y="18" width="427" height="33" as="geometry"/></mxCell><mxCell id="c3" value="Modelo C4 · Nivel 1 (contexto del sistema) · Sistema web multisede para salones de belleza" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#6A6A6A;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="28" y="52" width="577" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Vista de contexto · v3" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontColor=#8A8A8A;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1542" y="28" width="130" height="18" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="286" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Reserva, cancela y consulta sus citas desde el celular&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="195" y="125" width="230" height="115" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="556" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Estilista&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Atiende citas y consulta su producción y comisiones&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="465" y="125" width="230" height="115" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="826" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Cajero&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Cobra servicios y productos; abre y cierra la caja&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="735" y="125" width="230" height="115" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="1096" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Administrador de sede&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Gestiona catálogo, inventario, personal y reportes de su sede&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1005" y="125" width="230" height="115" as="geometry"/></mxCell><mxCell id="c13" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;" vertex="1" parent="1"><mxGeometry x="1366" y="83" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;SuperAdministrador&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#C9D6EA&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Crea sedes y usuarios; ve indicadores de todas las sedes&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1F3B66;strokeColor=#152A4A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1275" y="125" width="230" height="115" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;AnyColor Salón&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#D5E0F2&#x27;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Plataforma web multisede: reserva concurrente de citas, POS y caja, inventario, personal, comisiones y reportes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2F5597;strokeColor=#21407A;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="620" y="390" width="460" height="150" as="geometry"/></mxCell><mxCell id="c16" value="Reserva y cancela citas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.152;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="322"/><mxPoint x="690" y="322"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Ve su agenda y comisiones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.326;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="300"/><mxPoint x="770" y="300"/></Array></mxGeometry></mxCell><mxCell id="c18" value="Registra ventas y caja" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Gestiona su sede" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.674;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="300"/><mxPoint x="930" y="300"/></Array></mxGeometry></mxCell><mxCell id="c20" value="Administra sedes y usuarios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.848;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="322"/><mxPoint x="1010" y="322"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Pasarela de pagos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Procesa cobros con tarjeta y Yape/Plin&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="260" y="670" width="250" height="125" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Servicio de mensajería&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;WhatsApp API y correo electrónico&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="570" y="670" width="250" height="125" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Almacenamiento de objetos&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#EFEFEF&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Imágenes de servicios y tickets (S3 / Cloudinary)&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#9A9A9A;strokeColor=#7E7E7E;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="880" y="670" width="250" height="125" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Proveedor PSE (SUNAT)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10.5px;color:#666666&#x27;&gt;[Sistema externo · futuro]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;Comprobantes electrónicos; fuera de alcance&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9E9E9;strokeColor=#8A8A8A;fontColor=#444444;fontFamily=Arial;dashed=1;" vertex="1" parent="1"><mxGeometry x="1190" y="670" width="250" height="125" as="geometry"/></mxCell><mxCell id="c25" value="Solicita cobros&lt;br&gt;[HTTPS/REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.239;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="578"/><mxPoint x="385" y="578"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Envía confirmaciones&lt;br&gt;y recordatorios [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.413;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="610"/><mxPoint x="695" y="610"/></Array></mxGeometry></mxCell><mxCell id="c27" value="Guarda imágenes&lt;br&gt;y tickets [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;endArrow=block;endFill=1;exitX=0.587;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="610"/><mxPoint x="1005" y="610"/></Array></mxGeometry></mxCell><mxCell id="c28" value="Emitirá comprobantes&lt;br&gt;(interfaz preparada)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4D4D4D;fontSize=11.5;fontFamily=Arial;dashed=1;endArrow=block;endFill=1;exitX=0.761;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="578"/><mxPoint x="1315" y="578"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Persona · Sistema / contenedor · Sistema externo · Previsto (etapa futura)&lt;br&gt;Flecha: relación con verbo y [protocolo] · Línea discontinua: elemento previsto para una etapa futura" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fontFamily=Arial;strokeColor=#9A9A9A;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="580" height="92" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• El sistema no guarda datos de tarjeta: solo el identificador de la transacción (RC09).&lt;br&gt;• Toda la información pertenece a una sede; cada usuario ve solo lo que su rol y su sede permiten (RC02, ADR-005).&lt;br&gt;• Los sistemas externos se integran por adaptadores; cambiar de proveedor no toca el negocio (ADR-006)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFBE8;strokeColor=#C7B25A;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="800" y="860" width="860" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>