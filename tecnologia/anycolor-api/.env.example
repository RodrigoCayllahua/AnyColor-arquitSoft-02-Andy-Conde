# Copia este archivo como .env y ajusta los valores.
PUERTO=3001
URL_FRONTEND=http://localhost:3000

# PostgreSQL: postgres://usuario:clave@servidor:puerto/base
DATABASE_URL=postgres://anycolor:anycolor@localhost:5432/anycolor

# Bloqueos de horario: "redis" (producción) o "memoria" (si aún no instalas Redis)
BLOQUEOS=redis
REDIS_URL=redis://localhost:6379

# Clave para firmar los tokens JWT (cámbiala por una frase larga)
JWT_SECRETO=cambia-esta-frase-por-una-larga-y-secreta
JWT_DURACION=8h
