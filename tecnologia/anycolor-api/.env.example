# Copia este archivo como .env y ajusta los valores.
PUERTO=3001
URL_FRONTEND=http://localhost:3000,http://localhost:3002

# Swagger (documentación): en producción va desactivado salvo que pongas SWAGGER=activado
SWAGGER=activado

# PostgreSQL: postgres://usuario:clave@servidor:puerto/base
DATABASE_URL=postgres://anycolor:anycolor@localhost:5432/anycolor

# Bloqueos de horario: "redis" (producción) o "memoria" (si aún no instalas Redis)
BLOQUEOS=redis
REDIS_URL=redis://localhost:6379

# Caché del catálogo: "redis", "memoria" o "desactivada" (para comparar en pruebas de carga)
CACHE=redis

# Clave para firmar los tokens JWT. OBLIGATORIO cambiarla (mínimo 32 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción la API NO arranca si se deja este valor de ejemplo.
JWT_SECRETO=cambia-esta-frase-por-una-larga-y-secreta
# Cuánto dura la sesión antes de pedir la clave otra vez
JWT_DURACION=2h

# Clave de PostgreSQL usada por docker compose (cámbiala fuera de tu PC)
DB_CLAVE=anycolor

# Límite de peticiones (rate limiting). "desactivado" SOLO para pruebas de carga con k6
LIMITE_PETICIONES=activado
LIMITE_GENERAL=300
LIMITE_LOGIN=20
LIMITE_REGISTRO=10
LIMITE_BLOQUEOS=30
# Bloqueo por fuerza bruta: intentos fallidos de login antes de bloquear, y minutos de bloqueo
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
